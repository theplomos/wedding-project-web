# ==============================================================================
# Database Configuration (PostgreSQL / Neon / Supabase / Vercel Postgres)
# ==============================================================================
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/dbname?sslmode=require"

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================
# 32+ character random string used to HMAC-sign session cookies (guest & admin)
SESSION_SECRET="generate_a_random_32_characters_secret_key_here"

# Password required to log into the Admin panel (/admin)
ADMIN_PASSWORD="set_a_strong_admin_password_here"

# Passcode for guests to unlock the RSVP matching flow
GUEST_PASSCODE="set_a_guest_passcode_here"

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Cloudinary (Photo & Video Guest Uploads)
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_ADMIN_API_KEY="your_cloudinary_admin_api_key"
CLOUDINARY_ADMIN_API_SECRET="your_cloudinary_admin_api_secret"
CLOUDINARY_UPLOAD_PRESET="your_upload_preset"
MAX_FILE_SIZE_MB=50

# ==============================================================================
# Spotify API (Song Suggestions & Collaborative Playlist)
# ==============================================================================
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIFY_PLAYLIST_ID="your_spotify_playlist_id"
